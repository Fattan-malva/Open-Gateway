# ===== Server =====
HOST=127.0.0.1
PORT=8787
# 1 = buka web UI otomatis saat `py main.py`
DS_OPEN_BROWSER=1
DS_LOG_LEVEL=info

# ===== Data persisten =====
# Profil Chrome + cookies + API key disimpan di sini agar login tidak hilang.
DS_DATA_DIR=./data
DS_PROFILE_DIR=./data/chrome-profile
DS_API_KEYS_FILE=./data/api_keys.json

# ===== Browser =====
DS_BASE_URL=https://chat.deepseek.com
DS_CHANNEL=chrome
# 1 = Chrome tanpa jendela (harus sudah login).
# Login dari tab Browser tetap membuka jendela terlihat.
DS_HEADLESS=0

# ===== Timeout dan batas prompt =====
DS_LOGIN_TIMEOUT=300
DS_REPLY_TIMEOUT=180
DS_MAX_PROMPT_CHARS=60000

# ===== Cookie sesi DeepSeek (opsional) =====
# Cara termudah: buka tab Browser di web UI lalu klik Login.
# Format header: DS_COOKIE=nama=nilai; nama2=nilai2
# Format JSON:   DS_COOKIE=[{"name":"...","value":"...","domain":".deepseek.com"}]
DS_COOKIE=

# ===== Override selector UI (opsional, pisahkan dengan ||) =====
# DS_INPUT_SELECTOR=textarea[placeholder]||#chat-input
# DS_SEND_SELECTOR=button[aria-label*='send' i]
# DS_STOP_SELECTOR=button[aria-label*='stop' i]
# DS_THINKING_SELECTOR=div[class*='ds-toggle-button']:has-text('Deep thinking')
# DS_SEARCH_SELECTOR=button:has-text('Search')
# DS_REASONING_SELECTOR=.ds-think-content

# 1 = simpan screenshot + HTML saat error
DS_DEBUG=0
