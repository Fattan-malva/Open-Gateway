// Contoh custom provider OpenCode V2 untuk open-masking.
// Jalankan `py main.py`, buat API key di tab API Keys, lalu set OPEN_MASKING_KEY.
// Pilih variant #deepthink, #search, atau #deepthink-search sesuai kebutuhan.
{
  "$schema": "https://opencode.ai/config.json",
  "model": "open-masking/deepseek-chat",
  "providers": {
    "open-masking": {
      "name": "open-masking",
      "env": ["OPEN_MASKING_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8787/v1"
      },
      "models": {
        "deepseek-chat": {
          "name": "DeepSeek Chat (Web)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "reasoning": { "supported": true, "toggle": true }
          },
          "compatibility": { "reasoningField": "reasoning_content" },
          "limit": { "context": 24000, "output": 8000 },
          "variants": [
            { "id": "deepthink", "body": { "thinking": true, "search": false } },
            { "id": "search", "body": { "thinking": false, "search": true } },
            { "id": "deepthink-search", "body": { "thinking": true, "search": true } }
          ]
        }
      }
    }
  }
}
